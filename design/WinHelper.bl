        9f3d39033da0a8e4 t("Strip shows only an icon and a value. Everything else lives in the tooltip.",Segoe UI,12,r,align(l),lh(1.45)) p(16,16) s(fill,hug:34.81) ext(218,) f[(1e9df9ab7119edd8,#3A3F47)] "Text 349"
        18ec3c07c4a3db58 t("Tooltip opens after ~400 ms hover over the strip, below it (flips above near the screen edge), and refreshes live while open.",Segoe UI,12,r,align(l),lh(1.45)) p(16,60.81) s(fill,hug:69.61) ext(218,) f[(1d4f1e64f7d3f5d5,#3A3F47)] "Text 350"
        c596c6629a9d58d4 t("Values stay neutral below 60 %, amber 60–85 %, red above 85 %. At red the icon turns red too.",Segoe UI,12,r,align(l),lh(1.45)) p(16,140.42) s(fill,hug:52.21) ext(218,) f[(5ecab5a246323e89,#3A3F47)] "Text 351"
        190f03434e70dba7 t("Disk shows active time % (same load colors). The tooltip adds read / write per second across all physical disks.",Segoe UI,12,r,align(l),lh(1.45)) p(16,202.63) s(fill,hug:52.21) ext(218,) f[(b49fc059951b72b4,#3A3F47)] "Text 375"
        8ca6cd29d95bd217 t("Temperatures sit next to CPU and GPU in °C, dimmed like units: amber 75–89 °C, red at 90 °C and up. Hidden when the sensor is unavailable.",Segoe UI,12,r,align(l),lh(1.45)) p(16,264.84) s(fill,hug:69.61) ext(218,) f[(b9da03e789aa0520,#3A3F47)] "Text 374"
        fd10f4423f787bf1 t("Globe + dot: green online, red offline (globe-x). Rates are per second from interface byte counters, auto-scaled B/KB/MB, fixed-width slots so the strip never jitters.",Segoe UI,12,r,align(l),lh(1.45)) p(16,344.45) s(fill,hug:87.01) ext(218,) f[(a9e37eabadb63576,#3A3F47)] "Text 352"
        972e09e8ab66a661 t("Close button appears on hover, 6 px right of the strip. Right-click menu is unchanged.",Segoe UI,12,r,align(l),lh(1.45)) p(16,441.46) s(fill,hug:52.21) ext(218,) f[(cc9763106c7cc4da,#3A3F47)] "Text 353"
bp:end
