// Resource script for WinHelper. Version macros are supplied by build.rs.

#define IDI_APP 1

IDI_APP ICON "winhelper.ico"

// CREATEPROCESS_MANIFEST_RESOURCE_ID (1), RT_MANIFEST (24)
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION  VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L  // VOS_NT_WINDOWS32
FILETYPE        0x1L      // VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "WinHelper system panel"
            VALUE "FileVersion",      VER_STR
            VALUE "InternalName",     "winhelper"
            VALUE "OriginalFilename", "winhelper.exe"
            VALUE "ProductName",      "WinHelper"
            VALUE "ProductVersion",   VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
